// app/page.tsx
"use client";

import { useState } from 'react';
import { SoverentityFrontend } from '@/components/SoverentityFrontend';
import { ContactManagement } from '@/components/ContactManagement';

export default function Home() {
  const [identity, setIdentity] = useState<any>(null);
  const [activeTab, setActiveTab] = useState<'identity' | 'contacts'>(identity ? 'contacts' : 'identity');
  
  // Function to handle identity update coming from SoverentityFrontend
  const handleIdentityUpdate = (newIdentity: any) => {
    console.log('Identity updated:', newIdentity);
    setIdentity(newIdentity);
    // Switch to contacts tab after creating identity
    if (newIdentity && !identity) {
      setActiveTab('contacts');
    }
  };

  return (
    <div className="min-h-screen p-8">
      <header className="mb-12 text-center">
        <h1 className="text-3xl font-bold mb-2">Soverentity</h1>
        <p className="text-muted-foreground">Decentralized, Sovereign Contact Management</p>
      </header>

      <main className="max-w-6xl mx-auto">
        {!identity ? (
          // If no identity is present, show only the identity creation component
          <SoverentityFrontend onIdentityUpdate={handleIdentityUpdate} />
        ) : (
          // If identity exists, show simple tab navigation instead of Tabs component
          <div>
            <div className="flex border-b mb-8 max-w-md mx-auto">
              <button 
                className={`py-2 px-4 font-medium ${activeTab === 'identity' ? 'border-b-2 border-black' : ''}`}
                onClick={() => setActiveTab('identity')}
              >
                Identity
              </button>
              <button
                className={`py-2 px-4 font-medium ${activeTab === 'contacts' ? 'border-b-2 border-black' : ''}`}
                onClick={() => setActiveTab('contacts')}
              >
                Contacts
              </button>
            </div>
            
            {activeTab === 'identity' && (
              <SoverentityFrontend 
                existingIdentity={identity}
                onIdentityUpdate={handleIdentityUpdate}
              />
            )}
            
            {activeTab === 'contacts' && (
              <ContactManagement identity={identity} />
            )}
          </div>
        )}
      </main>

      <footer className="mt-16 text-center text-sm text-muted-foreground">
        <p>Soverentity - Self-Sovereign Identity & Contact Management</p>
        <p className="mt-1">All data is encrypted and stored locally.</p>
      </footer>
    </div>
  );
}