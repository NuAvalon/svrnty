// app/api/simple-contacts/route.ts
import { NextResponse } from 'next/server';
import { SoverentityIdentity } from '@/lib/identity/core';
import { RobustContactManager } from '@/lib/contacts/robust-db';
import { Contact } from '@/lib/contacts/types';
import { randomUUID } from 'crypto';

const identityManager = new SoverentityIdentity();

// In-memory fallback storage for contacts when file system is not available
const memoryContactStore = new Map<string, Contact[]>();

async function getContactManager(fingerprint: string) {
  try {
    // Try to load the identity and keys first
    const identity = await identityManager.loadIdentityData(fingerprint);
    if (!identity) {
      throw new Error('Identity not found');
    }

    const keyData = await identityManager.loadKey(fingerprint);
    
    // Create contact manager with robust error handling
    const contactManager = new RobustContactManager({
      userFingerprint: fingerprint,
      userPublicKey: identity.identity.public_key,
      userPrivateKey: keyData.privateKey,
      userPassphrase: keyData.passphrase
    });
    
    // Initialize the contact manager
    await contactManager.initialize();
    
    return { contactManager, storageType: 'encrypted' };
    
  } catch (error) {
    console.warn('Failed to initialize encrypted contact storage:', error);
    console.warn('Falling back to in-memory storage');
    
    // Fall back to in-memory storage
    if (!memoryContactStore.has(fingerprint)) {
      memoryContactStore.set(fingerprint, []);
    }
    
    return { 
      contactManager: null, 
      storageType: 'in-memory',
      fallbackReason: error instanceof Error ? error.message : 'Unknown error'
    };
  }
}

// GET - Load contacts
export async function GET(request: Request) {
  console.log('API route hit: /api/simple-contacts [GET]');
  
  try {
    const url = new URL(request.url);
    const fingerprint = url.searchParams.get('fingerprint');
    
    if (!fingerprint) {
      return NextResponse.json(
        { error: 'Fingerprint is required' },
        { status: 400 }
      );
    }

    const { contactManager, storageType, fallbackReason } = await getContactManager(fingerprint);
    
    let contacts: Contact[] = [];
    
    if (contactManager) {
      // Use encrypted storage
      try {
        contacts = await contactManager.getAllContacts();
        console.log(`Loaded ${contacts.length} contacts from encrypted storage`);
      } catch (error) {
        console.error('Failed to load from encrypted storage:', error);
        // Fall back to memory if encrypted storage fails
        contacts = memoryContactStore.get(fingerprint) || [];
      }
    } else {
      // Use in-memory storage
      contacts = memoryContactStore.get(fingerprint) || [];
      console.log(`Loaded ${contacts.length} contacts from in-memory storage`);
    }

    return NextResponse.json({
      success: true,
      contacts,
      storage: storageType,
      ...(fallbackReason && { fallbackReason })
    });

  } catch (error) {
    console.error('Failed to load contacts:', error);
    return NextResponse.json(
      { 
        error: 'Failed to load contacts',
        details: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    );
  }
}

// POST - Add contact
export async function POST(request: Request) {
  console.log('API route hit: /api/simple-contacts [POST]');
  
  try {
    const body = await request.json();
    const { fingerprint, contact } = body;
    
    if (!fingerprint || !contact) {
      return NextResponse.json(
        { error: 'Fingerprint and contact data are required' },
        { status: 400 }
      );
    }

    // Validate contact data
    if (!contact.name || !contact.email || !contact.fingerprint || !contact.public_key) {
      return NextResponse.json(
        { error: 'Contact must have name, email, fingerprint, and public_key' },
        { status: 400 }
      );
    }

    const { contactManager, storageType } = await getContactManager(fingerprint);
    
    // Create new contact with ID and timestamp
    const newContact: Contact = {
      id: randomUUID(),
      name: contact.name,
      email: contact.email,
      fingerprint: contact.fingerprint,
      public_key: contact.public_key,
      trust_level: contact.trust_level || 'unverified',
      added_at: new Date().toISOString(),
      ...(contact.metadata && { metadata: contact.metadata })
    };

    if (contactManager) {
      // Use encrypted storage
      try {
        await contactManager.addContact(newContact);
        console.log('Contact added to encrypted storage');
      } catch (error) {
        console.error('Failed to add to encrypted storage:', error);
        
        // Fall back to memory storage
        const contacts = memoryContactStore.get(fingerprint) || [];
        
        // Check for duplicates
        if (contacts.some(c => c.fingerprint === newContact.fingerprint)) {
          return NextResponse.json(
            { error: 'Contact with this fingerprint already exists' },
            { status: 409 }
          );
        }
        
        contacts.push(newContact);
        memoryContactStore.set(fingerprint, contacts);
        console.log('Contact added to in-memory storage as fallback');
      }
    } else {
      // Use in-memory storage
      const contacts = memoryContactStore.get(fingerprint) || [];
      
      // Check for duplicates
      if (contacts.some(c => c.fingerprint === newContact.fingerprint)) {
        return NextResponse.json(
          { error: 'Contact with this fingerprint already exists' },
          { status: 409 }
        );
      }
      
      contacts.push(newContact);
      memoryContactStore.set(fingerprint, contacts);
      console.log('Contact added to in-memory storage');
    }

    return NextResponse.json({
      success: true,
      contact: newContact,
      storage: storageType
    });

  } catch (error) {
    console.error('Failed to add contact:', error);
    return NextResponse.json(
      { 
        error: 'Failed to add contact',
        details: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    );
  }
}

// PUT - Update contact
export async function PUT(request: Request) {
  console.log('API route hit: /api/simple-contacts [PUT]');
  
  try {
    const body = await request.json();
    const { fingerprint, contactId, updates } = body;
    
    if (!fingerprint || !contactId || !updates) {
      return NextResponse.json(
        { error: 'Fingerprint, contactId, and updates are required' },
        { status: 400 }
      );
    }

    const { contactManager, storageType } = await getContactManager(fingerprint);
    
    if (contactManager) {
      // Use encrypted storage
      try {
        await contactManager.updateContact(contactId, updates);
        console.log('Contact updated in encrypted storage');
      } catch (error) {
        console.error('Failed to update in encrypted storage:', error);
        
        // Fall back to memory storage
        const contacts = memoryContactStore.get(fingerprint) || [];
        const contactIndex = contacts.findIndex(c => c.id === contactId);
        
        if (contactIndex === -1) {
          return NextResponse.json(
            { error: 'Contact not found' },
            { status: 404 }
          );
        }
        
        contacts[contactIndex] = { ...contacts[contactIndex], ...updates };
        memoryContactStore.set(fingerprint, contacts);
        console.log('Contact updated in in-memory storage as fallback');
      }
    } else {
      // Use in-memory storage
      const contacts = memoryContactStore.get(fingerprint) || [];
      const contactIndex = contacts.findIndex(c => c.id === contactId);
      
      if (contactIndex === -1) {
        return NextResponse.json(
          { error: 'Contact not found' },
          { status: 404 }
        );
      }
      
      contacts[contactIndex] = { ...contacts[contactIndex], ...updates };
      memoryContactStore.set(fingerprint, contacts);
      console.log('Contact updated in in-memory storage');
    }

    return NextResponse.json({
      success: true,
      message: 'Contact updated successfully',
      storage: storageType
    });

  } catch (error) {
    console.error('Failed to update contact:', error);
    return NextResponse.json(
      { 
        error: 'Failed to update contact',
        details: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    );
  }
}

// DELETE - Delete contact
export async function DELETE(request: Request) {
  console.log('API route hit: /api/simple-contacts [DELETE]');
  
  try {
    const url = new URL(request.url);
    const fingerprint = url.searchParams.get('fingerprint');
    const contactId = url.searchParams.get('contactId');
    
    if (!fingerprint || !contactId) {
      return NextResponse.json(
        { error: 'Fingerprint and contactId are required' },
        { status: 400 }
      );
    }

    const { contactManager, storageType } = await getContactManager(fingerprint);
    
    if (contactManager) {
      // Use encrypted storage
      try {
        await contactManager.deleteContact(contactId);
        console.log('Contact deleted from encrypted storage');
      } catch (error) {
        console.error('Failed to delete from encrypted storage:', error);
        
        // Fall back to memory storage
        const contacts = memoryContactStore.get(fingerprint) || [];
        const contactIndex = contacts.findIndex(c => c.id === contactId);
        
        if (contactIndex === -1) {
          return NextResponse.json(
            { error: 'Contact not found' },
            { status: 404 }
          );
        }
        
        contacts.splice(contactIndex, 1);
        memoryContactStore.set(fingerprint, contacts);
        console.log('Contact deleted from in-memory storage as fallback');
      }
    } else {
      // Use in-memory storage
      const contacts = memoryContactStore.get(fingerprint) || [];
      const contactIndex = contacts.findIndex(c => c.id === contactId);
      
      if (contactIndex === -1) {
        return NextResponse.json(
          { error: 'Contact not found' },
          { status: 404 }
        );
      }
      
      contacts.splice(contactIndex, 1);
      memoryContactStore.set(fingerprint, contacts);
      console.log('Contact deleted from in-memory storage');
    }

    return NextResponse.json({
      success: true,
      message: 'Contact deleted successfully',
      storage: storageType
    });

  } catch (error) {
    console.error('Failed to delete contact:', error);
    return NextResponse.json(
      { 
        error: 'Failed to delete contact',
        details: error instanceof Error ? error.message : 'Unknown error'
      },
      { status: 500 }
    );
  }
}